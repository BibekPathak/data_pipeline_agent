# --- LLM Provider ---
# deterministic | openai
SHP_LLM_PROVIDER=deterministic
# Only used when SHP_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Agent guardrails / budgets ---
SHP_MAX_ITERATIONS=12
SHP_MAX_TOOL_CALLS=40
SHP_EXECUTION_TIMEOUT_SECONDS=300
SHP_MAX_BUDGET_ROWS=2000000
SHP_MAX_BUDGET_BYTES=268435456

# --- Approval mode ---
# auto | manual | human_in_loop
SHP_APPROVAL_MODE=auto

# --- Storage ---
# sqlite | memory
SHP_STORAGE_BACKEND=sqlite
SHP_DB_PATH=./data/pipeline.db

# --- Pipeline / data dirs ---
SHP_PIPELINE_DIR=./pipelines
SHP_FIXTURE_DIR=./datasets/fixtures
